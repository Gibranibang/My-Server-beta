[Run]
Filename: "msiexec.exe"; Parameters: "/i ""{app}\resources\deps\zerotier\ZeroTier One.msi"" /qn /norestart"; StatusMsg: "Installing ZeroTier One service..."; Flags: runhidden waituntilterminated; Check: NeedsZeroTierInstall
Filename: "{sys}\sc.exe"; Parameters: "config ZeroTierOneService start= auto"; Flags: runhidden waituntilterminated
Filename: "{sys}\sc.exe"; Parameters: "start ZeroTierOneService"; Flags: runhidden waituntilterminated
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#MyAppName}}"; Flags: nowait postinstall skipifsilent runasoriginaluser

[Code]
var
  IsUpgradeMode: Boolean;
  DetectedPath: String;

function NeedsZeroTierInstall(): Boolean;
begin
  if not FileExists(ExpandConstant('{app}\resources\deps\zerotier\ZeroTier One.msi')) then
  begin
    Result := False;
    Exit;
  end;
  if RegKeyExists(HKLM, 'SYSTEM\CurrentControlSet\Services\ZeroTierOneService') then
  begin
    Result := False;
    Exit;
  end;
  if FileExists(ExpandConstant('{commonappdata}\ZeroTier\One\zerotier-one_x64.exe')) or
     FileExists(ExpandConstant('{commonappdata}\ZeroTier\One\zerotier-one.port')) or
     FileExists(ExpandConstant('{pf64}\ZeroTier\One\zerotier-one_x64.exe')) or
     FileExists(ExpandConstant('{pf32}\ZeroTier\One\ZeroTier One.exe')) or
     FileExists(ExpandConstant('{pf32}\ZeroTier\One\zerotier-one_x86.exe')) then
  begin
    Result := False;
    Exit;
  end;
  Result := True;
end;

function GetExistingAppDir(): String;
var
  S: String;
begin
  Result := '';
  // 1. Cek registry HKCU (instalasi per-user saat ini)
  if RegQueryStringValue(HKCU, 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{5D8C7A3B-8C4E-4B1C-9A5F-2D3E6F7A8B9C}_is1', 'Inno Setup: App Path', S) and (S <> '') then
    Result := S
  else if RegQueryStringValue(HKCU, 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{5D8C7A3B-8C4E-4B1C-9A5F-2D3E6F7A8B9C}_is1', 'InstallLocation', S) and (S <> '') then
    Result := S
  // 2. Cek registry HKLM (jika pernah dipasang untuk semua pengguna)
  else if RegQueryStringValue(HKLM, 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{5D8C7A3B-8C4E-4B1C-9A5F-2D3E6F7A8B9C}_is1', 'Inno Setup: App Path', S) and (S <> '') then
    Result := S
  else if RegQueryStringValue(HKLM, 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{5D8C7A3B-8C4E-4B1C-9A5F-2D3E6F7A8B9C}_is1', 'InstallLocation', S) and (S <> '') then
    Result := S;
end;

function GetInstallDir(Param: String): String;
begin
  if DetectedPath <> '' then
    Result := DetectedPath
  else
    Result := ExpandConstant('{autopf}\{#MyAppName}');
end;

procedure TryGracefulAppShutdown();
var
  Http: Variant;
  TokenPath: String;
  CoreTokenAnsi: AnsiString;
  CoreToken: String;
begin
  try
    CoreToken := '';
    TokenPath := ExpandConstant('{localappdata}\MyServer\core.token');
    if FileExists(TokenPath) and LoadStringFromFile(TokenPath, CoreTokenAnsi) then
      CoreToken := Trim(String(CoreTokenAnsi));
    Http := CreateOleObject('WinHttp.WinHttpRequest.5.1');
    Http.SetTimeouts(500, 500, 1000, 1000);
    Http.Open('POST', 'http://127.0.0.1:48123/api/quit_app', False);
    Http.SetRequestHeader('Content-Type', 'application/json');
    if CoreToken <> '' then
      Http.SetRequestHeader('X-MyServer-Core-Token', CoreToken);
    Http.Send('{}');
    Sleep(1200);
  except
    // Core Service sedang tidak berjalan atau belum siap; lanjut ke langkah berikutnya
  end;
end;

procedure StopRunningAppProcesses();
var
  ResultCode: Integer;
begin
  TryGracefulAppShutdown();
  Exec(
    AddBackslash(ExpandConstant('{sys}')) + 'taskkill.exe',
    '/F /IM MyServer-Beta.exe /IM MyServer.exe /IM myserver-core.exe /IM syncthing.exe /IM easytier-core.exe /IM easytier-cli.exe',
    '',
    SW_HIDE,
    ewWaitUntilTerminated,
    ResultCode
  );
  Sleep(1000);
end;

function InitializeSetup(): Boolean;
begin
  DetectedPath := GetExistingAppDir();
  IsUpgradeMode := (DetectedPath <> '');
  Result := True;
end;

function PrepareToInstall(var NeedsRestart: Boolean): String;
begin
  StopRunningAppProcesses();
  Result := '';
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
  // Saat mode update, lewati halaman pemilihan folder agar tetap di folder instalasi yang sudah ada
  if IsUpgradeMode and (PageID = wpSelectDir) then
    Result := True
  else
    Result := False;
end;

procedure CurPageChanged(CurPageID: Integer);
begin
  if IsUpgradeMode and (CurPageID = wpReady) then
  begin
    WizardForm.NextButton.Caption := '&Update';
  end;
end;

function InitializeUninstall(): Boolean;
begin
  StopRunningAppProcesses();
  Result := True;
end;
